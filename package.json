{
  "name": "call",
  "version": "3.9.5-beta1",
  "description": "Construct Assistant for LeviLamina (LL3 / LegacyScriptEngine port)",
  "main": "index.js",
  "scripts": {
    "fetch-types": "node --use-system-ca scripts/fetch-types.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs --no-zip --no-deps",
    "deploy": "node scripts/build.mjs --no-zip --deploy",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:live": "node scripts/test-live.mjs",
    "server:dev": "node scripts/dev-run-server.mjs",
    "check:config": "node scripts/check-config.mjs",
    "test:unit": "node --test tests/unit/",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owoser/CALL.git"
  },
  "author": "superx101 (original) / owoser (LL3 maintainer)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/owoser/CALL/issues"
  },
  "homepage": "https://github.com/owoser/CALL#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "acorn": "^8.8.1",
    "cli-progress": "^3.11.2",
    "escodegen": "^2.0.0",
    "estraverse": "^5.3.0",
    "fast-json-patch": "^3.1.1",
    "properties-reader": "^2.2.0",
    "sprintf-js": "^1.1.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.0",
    "@types/escodegen": "^0.0.7",
    "@types/estraverse": "^5.1.2",
    "@types/node": "^22.10.2",
    "@types/properties-reader": "^2.1.1",
    "@types/sprintf-js": "^1.1.2",
    "typescript": "^5.7.2"
  }
}
