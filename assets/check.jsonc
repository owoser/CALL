        "silentContainerClear": {
    "type": "boolean",
    "default": true,
    "description": "粘贴/撤销覆盖带物品的容器前，用容器 API 清空其内容，避免替换方块时把物品全掉到地上。"
  },
  "previewNearRadius": {
    "type": "number",
    "default": 5,
    "description": "预览时玩家靠近多少格内的假方块变成可穿过的硫磺立方体；0 = 关闭。"
  },
  "previewNearInvisible": {
    "type": "boolean",
    "default": true,
    "description": "可穿过的立方体是否隐身（true = 方块看着没变，但能直接穿过去）。"
  },
  "previewNearScale": {
    "type": "number",
    "default": 1,
    "description": "靠近可穿的硫磺立方体缩放，1 = 正常大小（0.0625 - 10）。方块看着像微缩模型时调大。"
  },
  "previewNearYOffset": {
    "type": "number",
    "default": 0,
    "description": "可穿方块模型的额外垂直偏移（单位：格），叠加在内置实测基准 -0.09 之上；0 = 与真方块齐平。"
  },
  "previewNearCells": {
    "type": "number",
    "default": 512,
    "description": "单次注册的可穿格子上限（库每次调用会整体替换该玩家的集合，且受字符串参数上限约束）。"
  },
  "previewMaxCells": {
            "type": "number",
