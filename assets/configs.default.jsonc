/*
 * CALL 配置（一个文件说清楚）。
 *
 * 改完保存后执行 /ca reload 即可生效（或重启服务器）。
 * 键的增删/改名必须同时把 version +1，并同步 assets/check.jsonc。
 *
 * 所有尺寸单位：格；所有时间单位：毫秒（注明“秒”的除外）。
 */
{
    "version": 10,

    // ===== 基础 ==========================================
    // 总开关；false = 整个插件不工作
    "enable": true,
    // 谁能用：all 所有人 / op 仅管理员 / customize 自定义名单（userlist.json）
    "permission": "op",
    // 生存模式生效（false = 只有创造能用）
    "suvivalModeActive": true,
    // 控制台语言 zh_CN / zh_TW / en_US / ru_RU
    "consoleLanguage": "zh_CN",
    // 调试模式：打开后输出 [DBG] 细节日志
    "debugMod": false,
    // 启动时打印 Logo
    "displayLogo": true,

    // ===== 结构 / 撤销 =====================================
    // 每人最多保存多少份结构
    "maxSaveStructure": 30,
    // 撤销栈深度（可回退几步）
    "maxUndoStep": 5,
    // 一次粘贴最多放置多少方块
    "maxPlaceBlocks": 40000,
    // 粘贴时每批处理多少方块
    "placeBatchBlocks": 2000,
    // 一次快照/还原的方块上限
    "maxRestoreBlocks": 2000000,
    // 遍历时每批之间的等待（毫秒）
    "traversalWaitTime": 300,
    // 每条 fill 指令后的等待（毫秒）
    "fillWaitTime": 40,
    // 区块加载方式：tickingarea
    "chunkLoader": "tickingarea",
    // 等待区块加载的超时（毫秒）
    "chunkLoadTimeout": 15000,
    // 加载时最多同时检查多少个区块
    "maxLoadCheckNum": 10,

    // ===== 工具物品 ========================================
    // 是否提供内置工具物品（可点击的魔杖）
    "toolItems": true,
    // 允许对空气右键触发（默认开）
    "toolAirClick": true,
    // 挥动检测轮询间隔（毫秒）
    "toolSwingPollMs": 200,

    // ===== 选区显示 ========================================
    // 选区显示方式 wireframe / none
    "areaDisplayMode": "wireframe",
    // 选区文字提示的刷新间隔（毫秒）
    "areaTextTipInterval": 1000,
    // 线框最远显示距离（格）
    "viewMaxDistance": 150,
    // 重建线框前是否整体重置（默认只销毁自己的）
    "wireframeResetAll": false,
    // 线框存活时间（0 = 常驻）
    "wireframeTtlSeconds": 0,
    // 销毁前先把线框挪走（避免闪一下）
    "wireframeParkBeforeDestroy": false,

    // ===== 预览 · 基础 =====================================
    // 预览方式 ghost = 假方块
    "previewMode": "ghost",
    // 预览倒计时显示 always / never / op
    "previewCountdown": "always",
    // 倒计时用 HUD 还是 Boss 条 auto / hud / bossbar
    "previewCountdownHud": "auto",
    // 预览自动结束时间（秒）
    "previewTimeout": 60,
    // 旋转基准 inplace = 原地 / corner = 角点
    "previewPivot": "inplace",
    // 预览最多显示多少方块（超出转分片）
    "previewMaxBlocks": 12000,
    // 预览窗口半径（格，跟随玩家）
    "previewRadius": 48,
    // 玩家移动多少格触发窗口更新
    "previewUpdateDistance": 8,
    // 预览可见距离（格）
    "previewViewDistance": 64,
    // 分片缓存数量
    "previewSliceCache": 8,
    // 预取分片数量
    "previewPrefetch": 16,
    // 是否画预览轮廓
    "previewOutline": true,
    // 轮廓采样步长（越大越省）
    "previewOutlineStep": 8,
    // 每 tick 用于预览的预算（毫秒）
    "previewTickBudgetMs": 8,
    // 多久补发一次窗口（秒）
    "previewResendSeconds": 45,

    // ===== 预览 · 批量 =====================================
    // 批量发送模式 auto / on / off
    "previewBatchMode": "auto",
    // 每包最多多少格
    "previewBatchCells": 1024,
    // 小批量直接发的阈值
    "previewBatchImmediate": 256,
    // 每 tick 最多发几包（库上限 8）
    "previewBatchPerTick": 6,
    // 队列积压上限（超过就等）
    "previewBatchQueueMax": 24,
    // 每批提交的格数
    "previewBatchSize": 1000,
    // Boss 条变化时是否重建
    "previewBossBarRebuild": true,

    // ===== 预览 · 方块实体 / 落块样式 ============================
    // 预览是否还原箱子/告示牌的内容
    "previewBlockEntity": true,
    // 预览最多推送多少个方块实体
    "previewBlockEntityMax": 64,
    // 预览方块显示缩放（字符串）
    "previewBlockScale": "1",
    // 预览方块垂直偏移（字符串）
    "previewBlockOffsetY": "0",
    // 方块显示的整体 Y 修正（实测值）
    "previewBlockYCorrection": 0.4149,
    // 库的最大渲染距离（格）
    "holoMaxRenderDistance": 256,

    // ===== 预览 · 靠近可穿 ===================================
    // 靠近多少格内的假方块变成可穿过（0 = 关闭）
    "previewNearRadius": 5,
    // 可穿显示体是否隐身（true = 只看得到方块）
    "previewNearInvisible": true,
    // 可穿显示体缩放（1 = 正常大小）
    "previewNearScale": 1,
    // 可穿显示体额外垂直偏移（格），叠加内置基准 -0.09
    "previewNearYOffset": 0,
    // 单次最多注册多少个可穿格子
    "previewNearCells": 512,
    // 预览总格数上限（超过走分片模式）
    "previewMaxCells": 800000,

    // ===== 粘贴同步 / 覆盖容器 =================================
    // 粘贴时方块实体处理 fake = 用假方块同步 / none 跳过
    "pasteSyncBlockEntities": "fake",
    // 粘贴同步半径（格）
    "pasteSyncRadius": 64,
    // 粘贴同步最多处理多少个方块实体
    "pasteSyncMax": 256,
    // 覆盖带物品的容器前先清空（避免物品掉一地）
    "silentContainerClear": true,

    // ===== 默认玩家设置（新玩家 / 重置设置时使用） =====
    "default": {
        // 是否启用 CALL
        "enable": true,
        // Boss 条进度显示：0 = 百分比，1 = 已放置/总数
        "barReplace": 0,
        "barReplaced": 1,
        // 记住选区
        "saveArea": true,
        // 保存撤销
        "saveUndo": true,
        // 保存剪贴板
        "saveCopy": true,
        // 保存实体（暂不支持，保留兼容）
        "saveEntity": true,
        // 显示选区文字
        "areaTextShow": true,
        // 显示选区线框
        "displayArea": true,
        // 显示进度条
        "displayProgressBar": true,
        // 加载区块时提示
        "loadChuckTip": true,
        "textureSelectorMode": false,
        // 自定义显示坐标，null = 跟随玩家
        "displayPos": null,
        "texture": { "a": null, "b": null },
        // 点击绑定：只认 call:* 工具物品（原版物品已移除，写了也不会生效）
        "items": {
                  "onUseItemOn": {
                            "call:gear": {
                                      "": {
                                                "cmds": [
                                                          "call menu"
                                                ],
                                                "describe": "⚙ 主菜单\nOpen menu"
                                      }
                            },
                            "call:wand_select": {
                                      "": {
                                                "cmds": [
                                                          "call area b ${block.pos.x} ${block.pos.y} ${block.pos.z}"
                                                ],
                                                "describe": "选区魔杖 · B点\nSelection wand: point B"
                                      }
                            },
                            "call:wand_copy": {
                                      "": {
                                                "cmds": [
                                                          "call copy"
                                                ],
                                                "describe": "复制魔杖\nCopy wand"
                                      }
                            },
                            "call:wand_paste": {
                                      "": {
                                                "cmds": [
                                                          "call paste ${block.pos.x} ${block.pos.y} ${block.pos.z}"
                                                ],
                                                "describe": "粘贴魔杖（有预览时左右键都贴在预览位置；没有预览时贴在点击位置）\nPaste wand: pastes at the preview when one is open, otherwise at the click"
                                      }
                            },
                            "call:wand_preview": {
                                      "": {
                                                "cmds": [
                                                          "call preview click ${block.pos.x} ${block.pos.y} ${block.pos.z}"
                                                ],
                                                "describe": "预览魔杖（右键=设点/旋转，左键=换落点，潜行左键=取消；粘贴请用粘贴魔杖）\nPreview wand: right = set/rotate, left = move, sneak+left = cancel"
                                      }
                            },
                            "call:wand_adjust": {
                                      "": {
                                                "cmds": [
                                                          "call preview nudgeface"
                                                ],
                                                "describe": "调整魔杖（朝点击的那一面挪一格，潜行反向）\nAdjust wand: nudge along the clicked face"
                                      }
                            }
                  },
                  "onStartDestroyBlock": {
                            "call:wand_select": {
                                      "": {
                                                "cmds": [
                                                          "call area a ${block.pos.x} ${block.pos.y} ${block.pos.z}"
                                                ],
                                                "describe": "选区魔杖 · A点\nSelection wand: point A"
                                      }
                            },
                            "call:wand_preview": {
                                      "": {
                                                "cmds": [
                                                          "call preview move ${block.pos.x} ${block.pos.y} ${block.pos.z}"
                                                ],
                                                "describe": "预览魔杖 · 换落点（潜行 = 取消预览）\nPreview wand: move anchor (sneak = cancel)"
                                      }
                            },
                            "call:wand_adjust": {
                                      "": {
                                                "cmds": [
                                                          "call preview pivot"
                                                ],
                                                "describe": "调整魔杖 · 切换旋转基准\nAdjust wand: switch rotation pivot"
                                      }
                            }
                  }
        },
        "area": {"start":{"x":null,"y":null,"z":null,"dimid":null},"end":{"x":null,"y":null,"z":null,"dimid":null}}
    }
}
